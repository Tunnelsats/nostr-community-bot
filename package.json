{
  "name": "nostr-community-bot",
  "version": "1.0.0",
  "description": "Modular, pluggable Nostr bot engine for E2EE DMs (NIP-17/NIP-59), Armada Concord V2 communities, and NIP-29 groups.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "nostr",
    "bot",
    "nip17",
    "nip59",
    "concord",
    "armada",
    "e2ee",
    "lightning"
  ],
  "author": "TunnelSats & Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tunnelsats/nostr-community-bot.git"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "nostr-tools": "^2.26.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
