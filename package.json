{
  "name": "nostr-community-bot",
  "version": "1.0.0",
  "description": "Modular, pluggable Nostr bot engine for E2EE DMs (NIP-17/NIP-59), Armada Concord V2 communities, and NIP-29 groups.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "nostr",
    "bot",
    "nip17",
    "nip59",
    "concord",
    "armada",
    "e2ee",
    "lightning"
  ],
  "author": "TunnelSats & Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tunnelsats/nostr-community-bot.git"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "nostr-tools": "^2.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.5",
    "@types/ws": "^8.5.12",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
